{
  "hosting": {
    "site": "esetec-marketplace",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "supprimer-image.js"
    ],
    "redirects": [
      { "source": "/", "destination": "/espace_client.html", "type": 302 }
    ],
    "headers": [
      {
        "source": "**/*.@(webp|jpg|jpeg|png|svg|gif|ico|mp4|webm)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      }
    ]
  }
}
